NEXT_PUBLIC_SITE_URL=https://www.grecybersec.co.uk
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare: reuse the existing widget. Only the site key is public.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional; defaults to the hostname in NEXT_PUBLIC_SITE_URL.
TURNSTILE_EXPECTED_HOSTNAME=

# Server-only, least-privilege JWT whose role claim is gcs_event_worker.
# Production deliberately refuses service-role/secret keys for public forms.
SUPABASE_EVENT_WORKER_JWT=
# Broad keys are accepted only outside production for migrations/local testing.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=
RESEND_API_KEY=
EVENT_EMAIL_FROM=
# Server-only recipient for private account, privacy and consent requests.
PRIVACY_CONTACT_EMAIL=
# Optional separate verified sender; otherwise EVENT_EMAIL_FROM is reused.
# CONTACT_EMAIL_FROM=
# RESEND_FROM_EMAIL is also accepted for an existing sender configuration.
CRON_SECRET=

# Optional overrides. The confirmed event date is fixed in lib/beyond-firewall.ts
# and the migration: Thursday 29 October 2026, 14:00-16:00 Europe/London.
EVENT_ORGANISER_NAME=GreCyberSec
EVENT_PRIVACY_CONTACT=/contact#privacy-request
EVENT_VERIFICATION_MINUTES=30
# Optional dedicated HMAC key (32+ characters); otherwise derives buckets with
# the server-only database credential. Changing either resets effective limits.
# EVENT_SECURITY_KEY=
