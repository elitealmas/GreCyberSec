NEXT_PUBLIC_SITE_URL=https://www.grecybersec.co.uk
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare: reuse the existing widget. Only the site key is public.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional; defaults to the hostname in NEXT_PUBLIC_SITE_URL.
TURNSTILE_EXPECTED_HOSTNAME=

# Server-only: reuse the existing Supabase secret/service-role credential.
# Set ONE. Existing restricted-worker installations may use the JWT instead.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_EVENT_WORKER_JWT=
RESEND_API_KEY=
EVENT_EMAIL_FROM=
# RESEND_FROM_EMAIL is also accepted for an existing sender configuration.
CRON_SECRET=

# Optional overrides. The confirmed event date is fixed in lib/beyond-firewall.ts
# and the migration: Thursday 29 October 2026, 14:00-16:00 Europe/London.
EVENT_ORGANISER_NAME=GreCyberSec
EVENT_PRIVACY_CONTACT=/contact
EVENT_VERIFICATION_MINUTES=30
# Optional dedicated HMAC key (32+ characters); otherwise derives buckets with
# the server-only database credential. Changing either resets effective limits.
# EVENT_SECURITY_KEY=
